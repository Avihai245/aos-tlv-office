# Supabase project "AOS-TLV" (ref mehghpqxlxoduxzhegsf)
NEXT_PUBLIC_SUPABASE_URL=https://mehghpqxlxoduxzhegsf.supabase.co
# Publishable key: safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_-S_oSMh_hDiOJCMXnS49tA_jZISZnGN
# Secret key: server only. Never prefix with NEXT_PUBLIC_, never commit. Used by the back office to create tenant/admin accounts
# (auth admin API), and later by the payment webhook (record_payment) and card tokens (save_payment_method).
SUPABASE_SERVICE_ROLE_KEY=
# Public address of the site, used for absolute links in previews and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: the hero background loop. By default the site plays the self-hosted muted MP4 at /uploads/hero.mp4, which plays on every
# phone and loads far less than the Vimeo player. Set another path to use a different file, or "vimeo" to use the Vimeo loop.
NEXT_PUBLIC_HERO_VIDEO=
